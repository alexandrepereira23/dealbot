{
    admin off
    auto_https disable_redirects
    skip_install_trust
    servers {
        protocols h1 h2
    }
}

https://localhost:8443 {
    tls internal
    @backend path /api /api/* /media /media/*
    handle @backend {
        reverse_proxy api:3333
    }
    handle {
        reverse_proxy painel:3000
    }
}
