# Somente interpolação do Compose e valores públicos de build. Sem service_role/TG.
DEALBOT_SHA=PREENCHER_SHA_COMPLETO
CADDY_NETWORK=PREENCHER_REDE_EXISTENTE
STATE_HOST_DIR=/srv/dealbot/state
MEDIA_HOST_DIR=/srv/dealbot/media
BOT_ENV_FILE=/etc/dealbot/bot.env
API_ENV_FILE=/etc/dealbot/api.env
BOT_UID=10001
API_UID=10002
FRONTEND_UID=10003
MEDIA_GID=10000
MIDIA_SAIDA_MAX_BYTES=358400
LIMPEZA_ATIVA=false
NEXT_PUBLIC_SUPABASE_URL=https://PREENCHER.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PREENCHER_CHAVE_PUBLICA
NEXT_PUBLIC_POLLING_LISTA_MS=5000
NEXT_PUBLIC_POLLING_STATS_MS=30000
# Caddy no host: portas somente em loopback.
API_LOOPBACK_PORT=13333
PAINEL_LOOPBACK_PORT=13000
