TG_API_ID=12345
TG_API_HASH=seu_api_hash
TG_SESSION_STRING=cole_a_session_gerada_aqui
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_secreta

# Estado local privado e persistente; não use /tmp nem pasta descartável de deploy.
BOT_STATE_DIR=/home/ubuntu/dealbot-state
BOT_RETENCAO_DIAS=7
BOT_LIMPEZA_INTERVALO_S=3600
BOT_OFERTA_WORKERS=4
BOT_MIDIA_WORKERS=1
# SQLite serializado: somente 1 é suportado nesta etapa.
BOT_IO_WORKERS=1
# Página de recuperação precisa caber no buffer; não é limite do histórico total.
BOT_BUFFER_MAX=100
BOT_RECUPERACAO_LOTE=100
BOT_RECUPERACAO_PAUSA_S=0.25
BOT_PRIORIDADE_LIVE_COTA=4
BOT_FILTROS_INTERVALO_S=15
BOT_CANAIS_INTERVALO_S=30
BOT_RECUPERACAO_INTERVALO_S=60
BOT_BOOTSTRAP_HORAS=24
BOT_REDE_TIMEOUT_S=10
BOT_MIDIA_TIMEOUT_S=30
BOT_MIDIA_MAX_BYTES=10485760
BOT_RETRY_BASE_S=1
BOT_RETRY_MAX_S=300
BOT_SHUTDOWN_TIMEOUT_S=25
