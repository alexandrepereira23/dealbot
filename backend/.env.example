PORT=3333
# Nos containers: 0.0.0.0, sem publicação pública de porta pelo Compose.
HOST=0.0.0.0
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_secreta
SUPABASE_ANON_KEY=anon_key_publica
CORS_ORIGIN=http://localhost:3000
RETENCAO_HORAS=48
# Retenção após terminalização/ack; não é TTL de trabalho recuperável.
RETENCAO_DIAS=7
LIMPEZA_INTERVALO_MIN=60
# false durante ensaio/preflight/backup; habilitar somente após prontidão.
LIMPEZA_ATIVA=true
LIMPEZA_LOTE=100
LIMPEZA_MAX_LOTES=10
# Mesmo diretório absoluto usado pelo bot quando BOT_MIDIA_MODO=local. A API só
# lê WebP final por GET/HEAD /media/<chave>; ela não acessa o SQLite do bot.
MIDIA_LOCAL_DIR=/home/ubuntu/dealbot-media
MIDIA_SAIDA_MAX_BYTES=358400
